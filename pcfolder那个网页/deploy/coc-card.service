[Unit]
Description=PC档案夹 Backend (Spring Boot)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
# 部署目录：/www/wwwroot/coc-card（与宝塔默认站点目录一致）
WorkingDirectory=/www/wwwroot/coc-card/backend
ExecStart=/usr/bin/java -Xms256m -Xmx512m -Dfile.encoding=UTF-8 -jar -Dspring.profiles.active=prod /www/wwwroot/coc-card/backend/coc-card-backend.jar
Restart=on-failure
RestartSec=10
# 后端日志同时写入此目录（application-prod.yml 已配置 /www/wwwroot/coc-card/logs/backend.log）
StandardOutput=append:/www/wwwroot/coc-card/logs/stdout.log
StandardError=append:/www/wwwroot/coc-card/logs/stderr.log

[Install]
WantedBy=multi-user.target
